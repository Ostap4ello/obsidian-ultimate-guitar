{
    "name": "obsidian-ultimate-guitar",
    "version": "0.2.0-beta.1",
    "private": true,
    "description": "Search, save, render, and practice Ultimate Guitar songs in Obsidian.",
    "main": "main.js",
    "scripts": {
        "build": "node esbuild.config.mjs production",
        "dev": "node esbuild.config.mjs development",
        "test": "node --test",
        "install:vault": "node scripts/install-vault.mjs",
        "release:check": "node scripts/release-check.mjs",
        "format": "prettier --write \"*.{json,js,mjs,ts,css,md}\" \"src/**/*.{ts,js}\" \"scripts/**/*.{js,mjs}\" \"test/**/*.{js,mjs}\"",
        "format:check": "prettier --check \"*.{json,js,mjs,ts,css,md}\" \"src/**/*.{ts,js}\" \"scripts/**/*.{js,mjs}\" \"test/**/*.{js,mjs}\""
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "esbuild": "^0.28.2",
        "obsidian": "^1.14.4",
        "prettier": "^3.6.2",
        "typescript": "^5.7.2"
    }
}
