{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "obsidian": ["node_modules/obsidian"]
    },
    "typeRoots": ["node_modules/@types", "node_modules/obsidian"],
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2021",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts"]
}
